<!-- Form Page (Extended Contact) -->
<section class="page-hero" style="background-image: url('/images/2023/01/governance-scaled.jpg');">
  <div class="container">
    <h1 class="page-hero-title">Contact Us</h1>
    <p class="page-hero-subtitle">We'll be in touch soon</p>
  </div>
</section>

<section class="contact-section">
  <div class="container">
    <div class="contact-grid">
      <div class="contact-form fade-in">
        <h3>Get In Touch</h3>
        <form id="extended-contact-form">
          <div class="form-row">
            <div class="form-group">
              <label for="form-fname">First Name *</label>
              <input type="text" id="form-fname" name="name" class="form-control" placeholder="First Name" required>
            </div>
            <div class="form-group">
              <label for="form-lname">Last Name *</label>
              <input type="text" id="form-lname" name="lastName" class="form-control" placeholder="Last Name" required>
            </div>
          </div>
          <div class="form-row">
            <div class="form-group">
              <label for="form-email">Email *</label>
              <input type="email" id="form-email" name="email" class="form-control" placeholder="you@company.com" required>
            </div>
            <div class="form-group">
              <label for="form-phone">Phone</label>
              <input type="tel" id="form-phone" name="phone" class="form-control" placeholder="(555) 123-4567">
            </div>
          </div>
          <div class="form-group">
            <label for="form-company">Company</label>
            <input type="text" id="form-company" name="subject" class="form-control" placeholder="Company Name">
          </div>
          <div class="form-group">
            <label for="form-message">Message *</label>
            <textarea id="form-message" name="message" class="form-control" placeholder="How can we help you?" required></textarea>
          </div>
          <button type="submit" class="btn btn-primary" style="width: 100%;">Submit</button>
          <div class="form-status"></div>
        </form>
      </div>
      <div class="contact-info fade-in-right">
        <h3>Our Office Locations</h3>
        <div class="contact-info-item">
          <div class="contact-info-icon">🇺🇸</div>
          <div class="contact-info-text">
            <h5>USA Office - Chicago</h5>
            <p>119 W. Hubbard<br>Chicago, IL 60611</p>
          </div>
        </div>
        <div class="contact-info-item">
          <div class="contact-info-icon">🇬🇧</div>
          <div class="contact-info-text">
            <h5>UK Office - London</h5>
            <p>27 Old Gloucester Street<br>London, WC1N 3AX</p>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
