<!-- Hero Banner -->
<section class="page-hero" style="background-image: url('/images/2023/01/Contactus-scaled.jpg');">
  <div class="container">
    <h1 class="page-hero-title">Contact Us</h1>
  </div>
</section>

<!-- Main Contact Section -->
<section class="contact-section" style="background-color: #000000; padding: 60px 0;">
  <div class="container">
    <div class="contact-grid">
      <!-- Left Column: Reach Out Details -->
      <div class="contact-info fade-in-left">
        <h2 style="color: #0A65FF; font-size: clamp(26px, 3.5vw, 36px); margin-bottom: 25px;">Reach out to us</h2>
        
        <div class="contact-info-item">
          <div class="contact-info-icon" style="color: #0A65FF; font-size: 22px;">✉</div>
          <div class="contact-info-text">
            <h5 style="color: #0A65FF; font-size: 18px; margin-bottom: 4px;">Email</h5>
            <p><a href="mailto:info1@datahubusa.com" style="color: #ffffff; font-size: 16px;">info1@datahubusa.com</a></p>
          </div>
        </div>

        <div class="contact-info-item">
          <div class="contact-info-icon" style="color: #0A65FF; font-size: 22px;">📞</div>
          <div class="contact-info-text">
            <h5 style="color: #0A65FF; font-size: 18px; margin-bottom: 4px;">Phone</h5>
            <p><a href="tel:8009678028" style="color: #ffffff; font-size: 16px;">(800) 967-8028</a></p>
          </div>
        </div>

        <div class="contact-info-item">
          <div class="contact-info-icon" style="color: #0A65FF; font-size: 22px;">📍</div>
          <div class="contact-info-text">
            <h5 style="color: #0A65FF; font-size: 18px; margin-bottom: 4px;">Address</h5>
            <p style="color: #ffffff; font-size: 16px;">119 W, Hubbard Suite 4E<br>Chicago IL, 60654</p>
          </div>
        </div>

        <div class="contact-info-item">
          <div class="contact-info-icon" style="color: #0A65FF; font-size: 22px;">🕐</div>
          <div class="contact-info-text">
            <h5 style="color: #0A65FF; font-size: 18px; margin-bottom: 4px;">Working Hours</h5>
            <p style="color: #ffffff; font-size: 16px;">Monday – Friday<br>7 AM – 9 PM CST</p>
          </div>
        </div>

        <div style="margin-top: 30px;">
          <h5 style="color: #0A65FF; font-size: 18px; margin-bottom: 8px;">Social Media</h5>
          <p style="color: #ffffff; margin-bottom: 12px;">Connect with us</p>
          <div class="footer-social">
            <a href="https://www.linkedin.com/company/datahubusa" target="_blank" rel="noopener" class="footer-social-link" aria-label="LinkedIn">in</a>
            <a href="https://twitter.com/databorgs" target="_blank" rel="noopener" class="footer-social-link" aria-label="Twitter">𝕏</a>
            <a href="https://www.youtube.com/@datahub-usa" target="_blank" rel="noopener" class="footer-social-link" aria-label="YouTube">▶</a>
          </div>
        </div>
      </div>

      <!-- Right Column: Contact Form -->
      <div class="contact-form contact-form-card fade-in-right" style="background: rgba(255, 255, 255, 0.03); border: 1px solid rgba(10, 101, 255, 0.2); border-radius: 12px;">
        <h2 style="color: #0A65FF; font-size: clamp(24px, 3vw, 32px); margin-bottom: 8px;">Contact Us</h2>
        <p style="color: #cccccc; margin-bottom: 25px;">We'll be in touch soon.</p>

        <form id="contact-form">
          <div class="form-group">
            <label for="contact-name" style="color: #ffffff;">Name *</label>
            <input type="text" id="contact-name" name="name" class="form-control" placeholder="Your Name" required>
          </div>

          <div class="form-group">
            <label for="contact-email" style="color: #ffffff;">Email Address *</label>
            <input type="email" id="contact-email" name="email" class="form-control" placeholder="your@email.com" required>
          </div>

          <div class="form-group">
            <label for="contact-phone" style="color: #ffffff;">Phone number</label>
            <input type="tel" id="contact-phone" name="phone" class="form-control" placeholder="(800) 123-4567">
          </div>

          <div class="form-group">
            <label for="contact-subject" style="color: #ffffff;">Subject</label>
            <input type="text" id="contact-subject" name="subject" class="form-control" placeholder="Subject">
          </div>

          <div class="form-group">
            <label for="contact-message" style="color: #ffffff;">Message *</label>
            <textarea id="contact-message" name="message" class="form-control" placeholder="Your Message" rows="5" required></textarea>
          </div>

          <button type="submit" class="btn btn-primary" style="width: 100%; font-size: 17px; padding: 14px 0; background: #000000; border: 2px solid #0A65FF; color: #ffffff;">Submit</button>
          <div class="form-status"></div>
        </form>
      </div>
    </div>

    <!-- Office Locations Section -->
    <div style="margin-top: 60px; padding-top: 40px; border-top: 1px solid rgba(10, 101, 255, 0.2);">
      <h2 class="text-center" style="color: #0A65FF; font-size: clamp(26px, 3.5vw, 36px); margin-bottom: 30px;">Our Office Locations</h2>
      <div class="section-row">
        <div class="text-center fade-in-left" style="background: rgba(255, 255, 255, 0.03); border: 1px solid rgba(10, 101, 255, 0.15); border-radius: 12px; padding: 30px 18px;">
          <p style="color: #0A65FF; font-size: 16px; font-weight: 700; letter-spacing: 2px; text-transform: uppercase; margin-bottom: 8px;">USA OFFICE</p>
          <h3 style="color: #0A65FF; font-size: clamp(26px, 3.5vw, 36px); font-weight: 800; margin-bottom: 12px;">CHICAGO</h3>
          <p style="color: #ffffff; font-size: 16px; line-height: 1.6;">119 W. Hubbard<br>Chicago, IL 60611</p>
        </div>
        <div class="text-center fade-in-right" style="background: rgba(255, 255, 255, 0.03); border: 1px solid rgba(10, 101, 255, 0.15); border-radius: 12px; padding: 30px 18px;">
          <p style="color: #0A65FF; font-size: 16px; font-weight: 700; letter-spacing: 2px; text-transform: uppercase; margin-bottom: 8px;">UK OFFICE</p>
          <h3 style="color: #0A65FF; font-size: clamp(26px, 3.5vw, 36px); font-weight: 800; margin-bottom: 12px;">LONDON</h3>
          <p style="color: #ffffff; font-size: 16px; line-height: 1.6;">27, Old Gloucester Street<br>LONDON WC1N 3AX</p>
        </div>
      </div>
    </div>
  </div>
</section>
