<!-- Hero Section -->
<section class="page-hero" style="background: #000000; padding: 70px 0;">
  <div class="container">
    <h1 class="page-hero-title" style="text-align: center; font-size: 50px; font-weight: 800;">Client Login</h1>
  </div>
</section>

<!-- Main Under Construction / Login Section -->
<section class="under-construction" style="background-color: #000000; padding: 60px 0 100px;">
  <div class="container text-center">
    <div style="max-width: 600px; margin: 0 auto;">
      <img src="/images/2023/01/Under-construction.gif" alt="Under Construction" loading="lazy" style="max-width: 100%; border-radius: 8px; margin-bottom: 30px;">
      <h2 style="color: #0A65FF; font-size: 40px; font-weight: 700; margin-bottom: 20px;">Under Construction</h2>
      <p style="color: #ffffff; font-size: 18px; line-height: 1.6; margin-bottom: 35px;">Our secure client portal is currently under scheduled maintenance and development. If you need immediate access to your reports or account management, please reach out to your dedicated account manager or contact our support team.</p>
      
      <!-- Quick Portal Login Card -->
      <div style="background: rgba(255, 255, 255, 0.03); border: 1px solid rgba(10, 101, 255, 0.2); border-radius: 12px; padding: 35px; text-align: left; margin-bottom: 30px;">
        <h3 style="color: #ffffff; font-size: 22px; margin-bottom: 20px; text-align: center;">Direct Portal Access</h3>
        <form onsubmit="event.preventDefault(); alert('The client portal is currently undergoing scheduled updates. Please contact support at info1@datahubusa.com for direct file retrieval.');">
          <div class="form-group" style="margin-bottom: 18px;">
            <label for="portal-user" style="color: #ffffff; display: block; margin-bottom: 6px; font-size: 14px;">Client ID / Email</label>
            <input type="text" id="portal-user" class="form-control" placeholder="client@company.com" required style="width: 100%; padding: 12px 16px; background: rgba(0,0,0,0.5); border: 1px solid rgba(10,101,255,0.3); border-radius: 6px; color: #fff;">
          </div>
          <div class="form-group" style="margin-bottom: 22px;">
            <label for="portal-pass" style="color: #ffffff; display: block; margin-bottom: 6px; font-size: 14px;">Password</label>
            <input type="password" id="portal-pass" class="form-control" placeholder="••••••••" required style="width: 100%; padding: 12px 16px; background: rgba(0,0,0,0.5); border: 1px solid rgba(10,101,255,0.3); border-radius: 6px; color: #fff;">
          </div>
          <button type="submit" class="btn btn-primary" style="width: 100%; padding: 14px; font-size: 16px;">Sign In to Portal</button>
        </form>
      </div>

      <div class="btn-group" style="justify-content: center; gap: 15px;">
        <a href="/contact-2" class="btn btn-primary" style="padding: 12px 28px;">Contact Support</a>
        <a href="/" class="btn btn-outline" style="padding: 12px 28px;">Return to Home</a>
      </div>
    </div>
  </div>
</section>