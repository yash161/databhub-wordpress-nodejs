<%
  // Name the service/industry the visitor is reading about so the contact form can be prefilled
  var ctaTopic = '';
  navigation.forEach(function(item) {
    (item.children || []).forEach(function(child) {
      if (child.url === currentPath && item.label !== 'About Us') ctaTopic = child.label;
    });
  });
  var ctaHref = '/contact-2' + (ctaTopic ? '?service=' + encodeURIComponent(ctaTopic) : '');
  var isContactPage = currentPath === '/contact-2' || currentPath === '/form';
%>
<% if (!isContactPage) { %>
<!-- Contact CTA band (shown above the footer on every page except the contact pages) -->
<section class="cta-band" aria-label="Contact DataHub">
  <div class="container cta-band-inner">
    <div class="cta-band-text">
      <h2 class="cta-band-title"><%= ctaTopic ? 'Talk to a DataHub ' + ctaTopic + ' expert' : 'Ready to secure, modernize, or make sense of your data?' %></h2>
      <p class="cta-band-desc">Tell us what you're working on and our Chicago team will get back to you. Prefer to talk? Call <a href="tel:+18009678028">(800) 967-8028</a>.</p>
    </div>
    <div class="cta-band-actions">
      <a href="<%= ctaHref %>" class="btn btn-primary" data-cta="cta-band">Contact Our Team</a>
      <a href="tel:+18009678028" class="btn btn-outline" data-cta="cta-band-call">Call (800) 967-8028</a>
    </div>
  </div>
</section>
<% } %>

<!-- Mobile quick-contact bar -->
<nav class="mobile-contact-bar" aria-label="Quick contact">
  <a href="tel:+18009678028" data-cta="mobile-call"><span aria-hidden="true">📞</span> Call</a>
  <a href="mailto:info1@datahubusa.com" data-cta="mobile-email"><span aria-hidden="true">✉</span> Email</a>
  <a href="<%= ctaHref %>" class="mobile-contact-primary" data-cta="mobile-contact">Contact Us</a>
</nav>
