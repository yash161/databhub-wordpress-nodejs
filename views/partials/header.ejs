<!-- Main Header -->
<header class="site-header" id="site-header">
  <div class="container header-inner">
    <a href="/" class="logo" aria-label="DataHub Home">
      <img src="/images/2022/12/logo-6-1.png" alt="DataHub - Where Data Meets Innovation" class="header-logo-img" width="180" height="78">
    </a>
    <button class="mobile-menu-toggle" id="mobile-menu-toggle" aria-label="Toggle menu" aria-expanded="false">
      <span class="hamburger-line"></span>
      <span class="hamburger-line"></span>
      <span class="hamburger-line"></span>
    </button>
    <nav class="main-nav" id="main-nav" aria-label="Main navigation">
      <ul class="nav-list">
        <% navigation.forEach(function(item) { %>
          <li class="nav-item<%= item.children && item.children.length ? ' has-dropdown' : '' %><%= currentPath === item.url ? ' active' : '' %>">
            <a href="<%= item.url %>" class="nav-link"><%= item.label %><% if (item.children && item.children.length) { %><span class="dropdown-arrow">▾</span><% } %></a>
            <% if (item.children && item.children.length) { %>
              <ul class="dropdown-menu">
                <% item.children.forEach(function(child) { %>
                  <li class="dropdown-item<%= currentPath === child.url ? ' active' : '' %>">
                    <a href="<%= child.url %>" class="dropdown-link"><%= child.label %></a>
                  </li>
                <% }); %>
              </ul>
            <% } %>
          </li>
        <% }); %>
      </ul>
    </nav>
  </div>
</header>
